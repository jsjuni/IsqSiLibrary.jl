    "version": "0.2.0",
    "configurations": [
        {
            "type": "julia",
            "request": "launch",
            "name": "CreateOML.jl",
            "program": "${workspaceFolder}/src/julia/CreateOML.jl",
            "stopOnEntry": false,
            "args": [
                "--creator", "J Steven Jenkins ORCID 0000-0002-0725-0884",
                "--input", "${workspaceFolder}/build/json/isq-si.json",
                "--server", "http://127.0.0.1:55411",
                "--path-base", "${workspaceFolder}/build/oml",
                "--namespace-base", "http://iso.org",
                "--defer-diagnostics"//, "--inhibit-updates"
            ]
        },
        {
            "type": "julia",
            "request": "launch",
            "name": "ProcessSources.jl",
            "program": "${workspaceFolder}/src/ProcessSources.jl",
            "stopOnEntry": false,
            "args": [
                "--sources-path-prefix", "${workspaceFolder}/resource/ISQ & SI Reference",
                "--dimensions-source", "SI Base Dimensions a72ac099666843ed86e0c23c45c5304a.csv",
                "--documents-source", "Defining Documents ff3fbbe356d348cfb81f1038b92ce8fe.csv",
                "--quantities-source", "ISQ Quantities e1b3e75b0f85444aa01339cbc9e867df.csv",
                "--units-source", "SI Units b419c70b1bf040e3b87a04a900378d01.csv",
                "--prefixes-source", "SI Prefixes 00b23fe2521d407688f118fd44e4e1f1.csv",
                "--symbols-source", "Quantity Symbols 3c0b24cf917a807a8b41fd799eb11f3b.csv",
                "--output", "${workspaceFolder}/build/json/isq-si.json"
            ]
        },
       {
            "type": "julia",
            "request": "launch",
            "name": "ProcessBIPMUnitsSource.jl",
            "program": "${workspaceFolder}/src/ProcessBIPMUnitsSource.jl",
            "stopOnEntry": false,
            "args": [
                "--units-file", "${workspaceFolder}/build/bipm.org/stage_1/units.json"
            ]
        },
       {
            "type": "julia",
            "request": "launch",
            "name": "ProcessBIPMQuantitiesSource.jl",
            "program": "${workspaceFolder}/src/ProcessBIPMQuantitiesSource.jl",
            "stopOnEntry": false,
            "args": [
                "--quantities-file", "${workspaceFolder}/build/bipm.org/stage_1/quantities.json"
            ]
        },
          {
            "type": "julia",
            "request": "launch",
            "name": "Run active Julia file",
            "program": "${file}",
            "stopOnEntry": false,
            "cwd": "${workspaceFolder}",
            "env": {},
            "juliaEnv": "${command:activeJuliaEnvironment}"
        }
    ]
}